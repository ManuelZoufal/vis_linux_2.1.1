# Vorlage für die Datei .env (kopieren: cp .env.example .env && chmod 600 .env)
# Zeilen mit # am Anfang sind auskommentiert; dort gilt der genannte Standardwert.

# ---- Pflicht: ohne diese beiden Werte startet die Anwendung nicht ----------------------------

# Schlüssel für die Sitzungs-Cookies, lang und zufällig, z. B. aus:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY="XXXXX"
# Passwort des Administrators beim ersten Anlegen; ein später geändertes Passwort bleibt erhalten
DEFAULT_ADMIN_PASSWORD="XXXXX"

# ---- Betrieb ---------------------------------------------------------------------------------

# Port des Webservers (Zahl, Standard 5000)
APP_PORT=XXXX
# Auf False lassen: True schaltet den Werkzeug-Debugger ein, der Code im Browser ausführen kann
APP_DEBUG=False
# Benutzername des Administrators beim ersten Anlegen (Standard admin)
DEFAULT_ADMIN_USER="XXXXX"

# ---- Zugangsdaten ----------------------------------------------------------------------------
# Diese Werte lassen sich als Administrator in der Oberfläche ändern ("Navigator-Zugang" und
# "Sensor-Zugang"); die Anwendung schreibt sie dann selbst in diese Datei.

# Navigator; ohne beide Werte findet kein Upload statt
NAVIGATOR_USERNAME="XXXXX"
NAVIGATOR_PASSWORD="XXXXX"

# Sensoren, Standard je Typ
# SENSOR_IEE_PASSWORD="XXXXX"
# SENSOR_HANWHA_USERNAME="XXXXX"
# SENSOR_HANWHA_PASSWORD="XXXXX"
# Einzelne Sensoren, die vom Standard ihres Typs abweichen (<ID> ist die sensor_id aus config.json)
# SENSOR_<ID>_USERNAME="XXXXX"
# SENSOR_<ID>_PASSWORD="XXXXX"

# Nur nötig, wenn auf dem Server HTTPS_PROXY gesetzt ist: Adressen der IEE-Sensoren, durch Komma getrennt
# NO_PROXY="XXX.XXX.XXX.XXX,XXX.XXX.XXX.XXX"

# ---- Optional, mit Standardwert --------------------------------------------------------------

# Gültigkeit einer Sitzung mit "Angemeldet bleiben", in Stunden
# SESSION_LIFETIME_HOURS=24
# Größte erlaubte Upload-Datei in MB
# MAX_UPLOAD_MB=5
# Zeitzone der angezeigten Zeitstempel
# APP_TIMEZONE="Europe/Berlin"
# Belegungsanzeige: roter Punkt, wenn ein zählender Sensor der Gruppe so viele Minuten keine Werte liefert
# DISPLAY_FAULT_MINUTES=5
# Hinweis für Administratoren ab so vielen Tagen vor Ablauf des Zertifikats
# CERT_WARN_DAYS=30
# Automatische Erneuerung des Zertifikats: an/aus, Restlaufzeit in Tagen, ab der erneuert wird,
# Gültigkeit des neuen Zertifikats in Tagen
# CERT_AUTO_RENEW=true
# CERT_RENEW_DAYS=1
# CERT_VALID_DAYS=365
# Eigene CA zum Ausstellen (liegen beide Dateien vor, stellt die CA aus; sonst selbstsigniert).
# CERT_CA_KEY_PASSWORD nur setzen, wenn der CA-Schlüssel mit einem Passwort geschützt ist.
# CERT_CA_CERT="ca.crt"
# CERT_CA_KEY="ca.key"
# CERT_CA_KEY_PASSWORD=""
# Login-Sperre: Fehlversuche je Adresse und Benutzername, Dauer der Sperre in Minuten
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15
# Abstand der Token-Anfragen an Navigator in Minuten, nachdem 5 in Folge fehlgeschlagen sind
# NAVIGATOR_RETRY_MINUTES=15
# Verzeichnis für Ereignis- und Detail-Protokoll, Größengrenze je Protokolldatei in MB,
# Anzahl aufbewahrter Detail-Protokolle
# LOG_DIR="logs"
# LOG_MAX_MB=200
# LOG_DETAIL_KEEP=5
